---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

// Months for the 2025–2026 school year — newest first
const months = [
	{ slug: 'may', name: 'May 2026', students: 'Faith Droessler · Daniel Schilling' },
	{ slug: 'april', name: 'April 2026', students: 'Kaylen Hastings · Barret Kreul' },
	{ slug: 'march', name: 'March 2026', students: 'Maddie Hadac · Molly McCue' },
	{ slug: 'february', name: 'February 2026', students: 'Kyle Frischman · Anna Tranel' },
	{ slug: 'january', name: 'January 2026', students: 'Jack Schultek · Brittany Walton' },
	{ slug: 'november', name: 'November 2025', students: 'Laurel Aquino · Leah Kellesvig' },
	{ slug: 'october', name: 'October 2025', students: 'Eleanor Guenther · Lily Nelson' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Someone You Should Know · Class of 2026 · ${SITE_TITLE}`} description="The Mount Horeb High School seniors honored by the Optimist Club of Mount Horeb, Wisconsin during the 2025–2026 school year." />
	</head>
	<body>
		<Header />
		<main>

<!-- Title -->
<section class="bg-white">
  <div class="max-w-3xl mx-auto px-6 py-16 text-center">
    <p class="text-sm tracking-[0.3em] uppercase text-optimist-slate">Someone You Should Know</p>
    <h1 class="mt-4 text-4xl md:text-5xl font-bold text-optimist-blue">Class of 2026</h1>
    <p class="mt-10 text-lg md:text-xl leading-relaxed text-optimist-blue">
      Each month of the school year, the Optimist Club of Mount Horeb, Wisconsin honors Mount Horeb High School seniors for outstanding community service. Here are the seniors we got to meet during the 2025&ndash;2026 school year.
    </p>
  </div>
</section>

<!-- Months -->
<section class="bg-optimist-beige">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <ul class="space-y-4 list-none">
      {months.map((m) => (
        <li>
          <a href={`/someone-you-should-know/class-of-2026/${m.slug}`} class="block bg-white px-6 py-6 rounded-sm hover:shadow-md transition-shadow">
            <p class="text-2xl md:text-3xl font-bold text-optimist-blue">{m.name}</p>
            <p class="mt-2 text-base md:text-lg text-optimist-slate">{m.students}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="bg-optimist-beige">
  <div class="max-w-3xl mx-auto px-6 py-16 text-center">
    <h2 class="text-sm tracking-[0.3em] uppercase text-optimist-slate">More students to know</h2>
    <ul class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 text-lg md:text-xl text-optimist-blue">
      <li><a href="/someone-you-should-know" class="hover:text-optimist-gold transition-colors">Someone You Should Know</a></li>
    </ul>
  </div>
</section>

		</main>
		<Footer />
	</body>
</html>
